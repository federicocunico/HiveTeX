# ---- Public URL of the deployment (used in emails, OAuth callbacks, CSRF origin checks) ----
APP_ORIGIN=https://your-app.vercel.app
# Extra allowed origins (comma separated), e.g. a custom domain. The desktop webview origins are built in.
EXTRA_ORIGINS=

# ---- Neon Postgres (Vercel Marketplace sets this) ----
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# ---- Upstash Redis (Vercel Marketplace sets these) ----
# The Vercel Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ---- Membership ticket signing key (Ed25519). See docs/deployment.md for the generator one-liner ----
TICKET_SIGNING_JWK={"kty":"OKP","crv":"Ed25519","d":"…","x":"…"}
TICKET_PUBLIC_JWKS=[{"kid":"k1","jwk":{"kty":"OKP","crv":"Ed25519","x":"…","alg":"EdDSA","use":"sig","kid":"k1"}}]
TICKET_KID=k1

# ---- Recovery email via Gmail SMTP (2-step verification + App Password) ----
GMAIL_USER=your.dedicated.account@gmail.com
GMAIL_APP_PASSWORD=

# ---- Optional: Cloudflare Realtime TURN (NAT relay) ----
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# ---- Optional: a fixed TURN account (ExpressTURN free tier, or any TURN server with a static user) ----
# Used besides Cloudflare when both are set. Every project member's device receives these, so use an account that is
# only good for relaying. TURN_SERVER is host:port (default free.expressturn.com:3478, over UDP and TCP); TURN_URLS
# overrides it with a comma-separated list of turn:/turns: URLs.
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SERVER=
TURN_URLS=

# ---- Optional: doorbell push service (docs/deployment.md#doorbell-push-service) ----
# Empty = the free public https://ntfy.sh; a self-hosted ntfy URL; or "off" (clients then keep sockets open: costly).
DOORBELL_URL=
# Desktop rollout switches, sent with every ticket: "off" stops background seeding / router port mapping on all
# desktops (foreground sync and stored data are unaffected).
DESKTOP_BACKGROUND=
DESKTOP_UPNP=

# ---- Recommended: application relay (off unless enabled; docs/deployment.md#application-relay) ----
# Members sync through the server first and move to a direct link once it proves itself: what guarantees sync when
# WebRTC fails. Upstash free tier: 500000 commands a month; about 5 commands per relayed frame.
# APPLICATION_RELAY=1
# RELAY_PROVIDER_COMMANDS=500000
# RELAY_BASELINE_COMMANDS=150000   # until measured with USAGE_LOG=1
# RELAY_ENVELOPES=60000            # at most (provider - baseline) / 5
# USAGE_LOG=1

# ---- Optional: GitHub App for backups (docs/github-backup.md) ----
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# ---- Optional switches ----
# Set to 0 to skip the Have-I-Been-Pwned range lookup (offline list is still used)
BREACHED_CHECK=1

# ---- Web build-time settings ----
# VITE_API_BASE=https://your-app.vercel.app     # desktop builds: absolute URL of the control plane
# VITE_TEXLIVE_URL=https://texlive.example.org/  # TeX file server for the in-browser engine

# ---- make setup inputs ----
# Put these in a git-ignored .env.setup (or the environment) to run `make setup` without prompts.
# GMAIL_USER=you.hivetex@gmail.com
# GMAIL_APP_PASSWORD=<16-character App Password>
# BOOTSTRAP_ADMIN=<username that becomes the first admin when it registers>
# CF_TURN_KEY_ID=            # optional, recommended (Cloudflare Realtime TURN)
# CF_TURN_API_TOKEN=
# TURN_USERNAME=            # optional: fixed TURN account, e.g. ExpressTURN (see above)
# TURN_CREDENTIAL=
# TURN_SERVER=              # host:port, default free.expressturn.com:3478
# APPLICATION_RELAY=1        # recommended; then RELAY_PROVIDER_COMMANDS, RELAY_BASELINE_COMMANDS, RELAY_ENVELOPES, USAGE_LOG
# VERCEL_PROJECT=hivetex     # used only when the checkout is not linked yet
# VERCEL_TOKEN=             # deploys after CI from GitHub Actions (create at https://vercel.com/account/tokens)
