{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HiveTeX",
  "version": "0.9.0",
  "identifier": "app.hivetex.desktop",
  "build": {
    "beforeDevCommand": "node prepare-worker.mjs && pnpm --filter @hivetex/web dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node prepare-worker.mjs && pnpm --filter @hivetex/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HiveTeX",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self' https: wss: ipc: http://ipc.localhost texcache: http://texcache.localhost https://api.github.com; object-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "resources": {"resources/node/": "node/", "resources/worker/": "worker/"},
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "fragmentPaths": ["windows/cleanup.wxs"],
        "componentGroupRefs": ["HiveTeXCleanupActions"]
      },
      "nsis": {
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5MEJCOUQ1QkIyOTgxMzUKUldRMWdTbTcxYmtMaWZVeWhRWmxzblJ2VUp0L0ZwQkVIQ2JRTmVuY0l0M2NyNDZ6NEtWZ2V5Ly8K",
      "endpoints": [
        "https://github.com/federicocunico/HiveTeX/releases/latest/download/latest.json"
      ]
    }
  }
}
