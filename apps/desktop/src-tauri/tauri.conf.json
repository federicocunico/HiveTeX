{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "p2platex",
  "version": "0.0.0",
  "identifier": "app.p2platex.desktop",
  "build": {
    "beforeDevCommand": "npx pnpm@10 --filter @p2platex/web dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx pnpm@10 --filter @p2platex/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{ "title": "p2platex", "width": 1280, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico", "icons/icon.png"] }
}
