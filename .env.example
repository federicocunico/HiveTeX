# ---- Public URL of the deployment (used in emails, OAuth callbacks, CSRF origin checks) ----
APP_ORIGIN=https://your-app.vercel.app
# Extra allowed origins (comma separated), e.g. a custom domain. The desktop webview origins are built in.
EXTRA_ORIGINS=

# ---- Neon Postgres (Vercel Marketplace sets this) ----
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# ---- Upstash Redis (Vercel Marketplace sets these) ----
# The Vercel Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ---- Membership ticket signing key (Ed25519). See docs/deployment.md for the generator one-liner ----
TICKET_SIGNING_JWK={"kty":"OKP","crv":"Ed25519","d":"…","x":"…"}
TICKET_PUBLIC_JWKS=[{"kid":"k1","jwk":{"kty":"OKP","crv":"Ed25519","x":"…","alg":"EdDSA","use":"sig","kid":"k1"}}]
TICKET_KID=k1

# ---- Recovery email via Gmail SMTP (2-step verification + App Password) ----
GMAIL_USER=your.dedicated.account@gmail.com
GMAIL_APP_PASSWORD=

# ---- Optional: Cloudflare Realtime TURN (NAT relay) ----
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# ---- Optional: GitHub App for backups (docs/github-backup.md) ----
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# ---- Optional switches ----
# Set to 0 to skip the Have-I-Been-Pwned range lookup (offline list is still used)
BREACHED_CHECK=1

# ---- Web build-time settings ----
# VITE_API_BASE=https://your-app.vercel.app     # desktop builds: absolute URL of the control plane
# VITE_TEXLIVE_URL=https://texlive.example.org/  # TeX file server for the in-browser engine
