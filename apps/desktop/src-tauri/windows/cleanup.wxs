<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <ComponentGroup Id="HiveTeXCleanupActions">
      <Component Id="HiveTeXCleanupMarker" Directory="INSTALLDIR" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\HiveTeX\Installer" Name="MSICleanup" Type="integer" Value="1" KeyPath="yes" />
          <RemoveFile Id="HiveTeXOldSetupUninstaller" Name="uninstall.exe" Property="HIVETEX_NSIS_DIR" On="install" />
        <RemoveFolder Id="HiveTeXOldSetupFolder" Property="HIVETEX_NSIS_DIR" On="install" />
      </Component>
    </ComponentGroup>
    <!-- Preserve state for MSI major upgrades and NSIS migration, which passes this secure property. -->
    <Property Id="HIVETEX_UPGRADE" Secure="yes" />
    <Property Id="HIVETEX_NSIS_UNINSTALL" Secure="yes">
      <RegistrySearch Id="HiveTeXPreviousSetup" Root="HKCU"
        Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\HiveTeX"
        Name="UninstallString" Type="raw" Win64="yes" />
    </Property>
    <Property Id="HIVETEX_NSIS_DIR" Secure="yes">
      <RegistrySearch Id="HiveTeXPreviousSetupDirectory" Root="HKCU"
        Key="Software\hivetex\HiveTeX" Type="raw" Win64="yes" />
    </Property>
    <CustomAction Id="HiveTeXMissingSetupDirectory" Error="Cannot locate the earlier HiveTeX setup directory. Repair that installation before installing MSI." />
    <CustomAction Id="HiveTeXRemoveSetup" Directory="INSTALLDIR"
      ExeCommand="[HIVETEX_NSIS_UNINSTALL] /S /UPDATE _?=[HIVETEX_NSIS_DIR]" Return="check" />
    <CustomAction Id="HiveTeXCleanup" FileKey="Path" ExeCommand="--uninstall-cleanup" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="HiveTeXMissingSetupDirectory" Before="HiveTeXRemoveSetup">NOT Installed AND HIVETEX_NSIS_UNINSTALL AND NOT HIVETEX_NSIS_DIR</Custom>
      <Custom Action="HiveTeXRemoveSetup" Before="InstallInitialize">NOT Installed AND HIVETEX_NSIS_UNINSTALL</Custom>
      <Custom Action="HiveTeXCleanup" Before="RemoveFiles">Installed AND REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND NOT HIVETEX_UPGRADE</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
