# Development-only defaults for the local docker stack (`make up`). NOT secrets: never reuse these anywhere real.
# Override any value by exporting it in your shell or in an untracked `.env` next to docker-compose.yml.

# ---- API (production wiring pointed at local emulators) ----
HIVETEX_DEV_STACK=1
APP_ORIGIN=http://localhost:8080
EXTRA_ORIGINS=http://localhost:1420
BREACHED_CHECK=0

# Neon emulator: the HTTP driver talks to neon-proxy, which forwards to the postgres service.
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/main
NEON_HTTP_ENDPOINT=http://neon-proxy:4444/sql

# Upstash emulator (serverless-redis-http in front of the redis service)
UPSTASH_REDIS_REST_URL=http://upstash:80
UPSTASH_REDIS_REST_TOKEN=dev-stack-token

# Mailpit catches every email; open http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=hivetex@localhost

# Ticket signing key: generated at start-up when empty (HIVETEX_DEV_STACK=1)
TICKET_SIGNING_JWK=
